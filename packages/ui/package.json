{
  "name": "@mft/ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./dist/index.css",
    "./tokens.css": "./src/tokens/tokens.css",
    "./logo-mark.svg": "./assets/logo-mark.svg"
  },
  "files": [
    "dist",
    "src/tokens/tokens.css",
    "assets"
  ],
  "scripts": {
    "tokens": "bun scripts/build-tokens.ts",
    "build": "bun run tokens && bun scripts/build.ts",
    "typecheck": "tsc --noEmit",
    "export:ds": "bun run build && bun scripts/export-design-system.ts"
  },
  "peerDependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "typescript": "5.6.3"
  }
}
